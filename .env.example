# Salin file ini ke .env.local untuk development lokal
# JANGAN commit file yang berisi secret ke git

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL (untuk Prisma jika diperlukan nanti)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# App Configuration
PUBLIC_APP_URL=http://localhost:4321

# WhatsApp Notification - Fonnte
FONNTE_TOKEN=your-fonnte-token-here

# Email Notification - Resend (opsional)
RESEND_API_KEY=your-resend-api-key-here

# Email Notification - SendGrid (opsional, alternatif Resend)
# SENDGRID_API_KEY=your-sendgrid-api-key-here

# Admin Configuration (tidak diperlukan lagi, menggunakan Supabase Auth)
# ADMIN_SESSION_SECRET=ubah-dengan-secret-yang-panjang-dan-acak
# ADMIN_EMAIL=admin@sditalhidayah.sch.id