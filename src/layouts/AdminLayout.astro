---
export const prerender = false;
import '../styles/global.css';

const { title = 'SISTER Admin', activeMenu = 'dashboard' } = Astro.props;
const user = Astro.locals.user;

// SEMENTARA: Semua admin yang login lihat semua menu
// Nanti diperbaiki dengan permission system yang lebih baik
const filteredGroups = [
  {
    id: 'dashboard',
    label: 'Dashboard',
    icon: 'dashboard',
    href: '/admin/dashboard',
  },
  {
    id: 'spmb',
    label: 'SPMB',
    icon: 'how_to_reg',
    children: [
      { id: 'verifikasi', label: 'Verifikasi Indent', href: '/admin/verifikasi' },
      { id: 'jadwal-tes', label: 'Jadwal & Seleksi Tes', href: '/admin/jadwal-tes' },
      { id: 'pengumuman', label: 'Pengumuman Hasil', href: '/admin/pengumuman' },
      { id: 'siswa', label: 'Data Pendaftar', href: '/admin/siswa' },
      { id: 'kriteria-seleksi', label: 'Kriteria Seleksi', href: '/admin/pengaturan/kriteria' },
    ],
  },
  {
    id: 'keuangan',
    label: 'Keuangan',
    icon: 'payments',
    children: [
      { id: 'konfirmasi-bayar', label: 'Konfirmasi Pembayaran', href: '/admin/pembayaran' },
      { id: 'belum-bayar', label: 'Belum Lunas', href: '/admin/pembayaran/belum-lunas' },
    ],
  },
  {
    id: 'akademik',
    label: 'Akademik',
    icon: 'school',
    children: [
      { id: 'kelas', label: 'Kelas', href: '/admin/kelas' },
      { id: 'jadwal', label: 'Jadwal Pelajaran', href: '/admin/jadwal' },
      { id: 'guru', label: 'Guru & Pegawai', href: '/admin/guru' },
    ],
  },
  {
    id: 'konten',
    label: 'Konten',
    icon: 'newspaper',
    children: [
      { id: 'berita', label: 'Berita & Artikel', href: '/admin/berita' },
      { id: 'broadcast', label: 'Broadcast', href: '/admin/broadcast' },
      { id: 'halaman', label: 'Kelola Halaman', href: '/admin/halaman' },
      { id: 'banner', label: 'Banner', href: '/admin/banner' },
      { id: 'faq', label: 'FAQ', href: '/admin/faq' },
    ],
  },
  {
    id: 'laporan',
    label: 'Laporan',
    icon: 'summarize',
    children: [
      { id: 'audit', label: 'Audit Trail', href: '/admin/audit' },
      { id: 'export', label: 'Export Data', href: '/admin/siswa' },
    ],
  },
  {
    id: 'sistem',
    label: 'Sistem',
    icon: 'settings',
    children: [
      { id: 'users', label: 'Manajemen Pengguna', href: '/admin/users' },
      { id: 'roles', label: 'Pengaturan Role', href: '/admin/pengaturan/roles' },
      { id: 'pengaturan', label: 'Pengaturan Umum', href: '/admin/pengaturan' },
      { id: 'spmb-settings', label: 'Pengaturan SPMB', href: '/admin/pengaturan/spmb' },
      { id: 'template-pengumuman', label: 'Template Pengumuman', href: '/admin/template-pengumuman' },
    ],
  },
];

const expandedGroups = new Set<string>();
filteredGroups.forEach(g => {
  if (g.children) {
    const hasActiveChild = g.children.some(c => c.id === activeMenu);
    if (hasActiveChild) expandedGroups.add(g.id);
  }
});
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/logo-sdit.png" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { font-family: 'Public Sans', sans-serif; }
    body { margin: 0; background: #f7f8fa; color: #1a1a2e; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .sidebar-link.active .material-symbols-outlined, .submenu-link.active .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }

    /* Sidebar */
    .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 280px; background: #fff; border-right: 1px solid #e5e7eb; z-index: 40; display: flex; flex-direction: column; transition: transform 0.2s; overflow-y: auto; }
    .sidebar-overlay { display: none; }

    @media (max-width: 1023px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 35; }
      .main-area { margin-left: 0 !important; }
    }

    @media (min-width: 1024px) {
      .sidebar { transform: translateX(0); }
      .main-area { margin-left: 280px; }
    }

    /* Scrollbar */
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-track { background: transparent; }
    .sidebar::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }

    /* Group header */
    .nav-group-header { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: 14px; font-weight: 500; color: #6b7280; border-left: 4px solid transparent; transition: all 0.15s; cursor: pointer; user-select: none; }
    .nav-group-header:hover { color: #1a1a2e; background: #f3f4f6; }
    .nav-group-header.active-group { color: #1e293b; background: #f1f5f9; border-left-color: #1e40af; }
    .nav-group-header .chevron { margin-left: auto; transition: transform 0.2s; font-size: 18px; }
    .nav-group-header.expanded .chevron { transform: rotate(180deg); }

    /* Single link (no children) */
    .sidebar-link { display: flex; align-items: center; gap: 12px; padding: 10px 20px; font-size: 14px; font-weight: 500; color: #6b7280; border-left: 4px solid transparent; transition: all 0.15s; text-decoration: none; }
    .sidebar-link:hover { color: #1a1a2e; background: #f3f4f6; }
    .sidebar-link.active { color: #1e293b; background: #f1f5f9; border-left-color: #1e40af; }

    /* Submenu */
    .submenu { display: none; background: #fafafa; border-left: 4px solid transparent; }
    .submenu.expanded { display: block; }
    .submenu-link { display: flex; align-items: center; gap: 10px; padding: 8px 20px 8px 52px; font-size: 13px; font-weight: 500; color: #6b7280; transition: all 0.15s; text-decoration: none; }
    .submenu-link:hover { color: #1a1a2e; background: #f3f4f6; }
    .submenu-link.active { color: #1e40af; background: #eff6ff; }
    .submenu-link .dot { width: 6px; height: 6px; border-radius: 50%; background: #d1d5db; }
    .submenu-link.active .dot { background: #1e40af; }

    /* Topbar */
    .topbar { position: sticky; top: 0; z-index: 30; background: #fff; border-bottom: 1px solid #e5e7eb; }

    /* Card */
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; }

    /* Stat card accent */
    .stat-card { position: relative; overflow: hidden; }
    .stat-card::after { content: ''; position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; border-radius: 50%; opacity: 0.08; }
    .stat-pending::after { background: #f59e0b; }
    .stat-verified::after { background: #3b82f6; }
    .stat-lulus::after { background: #10b981; }
    .stat-rejected::after { background: #ef4444; }
    .stat-total::after { background: #8b5cf6; }

    /* Table */
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead th { padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
    .data-table tbody td { padding: 12px 16px; font-size: 14px; border-bottom: 1px solid #f3f4f6; }
    .data-table tbody tr:hover { background: #f9fafb; }

    /* Badge */
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; }
    .badge-pending { background: #fef3c7; color: #92400e; }
    .badge-verified { background: #dbeafe; color: #1e40af; }
    .badge-document_complete { background: #ccfbf1; color: #115e59; }
    .badge-scheduled { background: #e0e7ff; color: #3730a3; }
    .badge-lulus { background: #d1fae5; color: #065f46; }
    .badge-tidak_lulus, .badge-rejected { background: #fee2e2; color: #991b1b; }

    /* Toggle */
    .toggle { position: relative; width: 44px; height: 24px; background: #d1d5db; border-radius: 9999px; cursor: pointer; transition: background 0.2s; }
    .toggle.active { background: #1e40af; }
    .toggle::after { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; background: #fff; border-radius: 50%; transition: transform 0.2s; }
    .toggle.active::after { transform: translateX(20px); }

    /* Input */
    .input { width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; font-family: inherit; outline: none; transition: border-color 0.15s, box-shadow 0.15s; }
    .input:focus { border-color: #1e40af; box-shadow: 0 0 0 3px rgba(30,64,175,0.1); }

    /* Button */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; font-family: inherit; cursor: pointer; border: none; transition: all 0.15s; }
    .btn-primary { background: #1e40af; color: #fff; }
    .btn-primary:hover { background: #1e3a8a; }
    .btn-outline { background: transparent; color: #1e40af; border: 1px solid #1e40af; }
    .btn-outline:hover { background: #eff6ff; }
    .btn-danger { background: #ef4444; color: #fff; }
    .btn-danger:hover { background: #dc2626; }
    .btn-ghost { background: transparent; color: #6b7280; }
    .btn-ghost:hover { background: #f3f4f6; color: #1a1a2e; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    
    /* Dark Mode */
    html.dark body { background: #0f172a; color: #e2e8f0; }
    html.dark .sidebar { background: #1e293b; border-color: #334155; }
    html.dark .topbar { background: #1e293b; border-color: #334155; }
    html.dark .card { background: #1e293b; border-color: #334155; }
    html.dark .nav-group-header { color: #94a3b8; }
    html.dark .nav-group-header:hover { background: #334155; color: #e2e8f0; }
    html.dark .sidebar-link { color: #94a3b8; }
    html.dark .sidebar-link:hover { background: #334155; color: #e2e8f0; }
    html.dark .submenu { background: #0f172a; }
    html.dark .submenu-link { color: #94a3b8; }
    html.dark .submenu-link:hover { background: #334155; color: #e2e8f0; }
    html.dark h1, html.dark h2, html.dark h3 { color: #f1f5f9; }
    html.dark .text-gray-500 { color: #94a3b8; }
    html.dark .text-gray-600 { color: #cbd5e1; }
    html.dark .text-gray-700 { color: #e2e8f0; }
    html.dark .text-gray-800 { color: #f1f5f9; }
    html.dark .text-gray-900 { color: #f8fafc; }
    html.dark .bg-gray-50 { background: #1e293b; }
    html.dark .bg-gray-100 { background: #334155; }
    html.dark .border-gray-100 { border-color: #334155; }
    html.dark .border-gray-200 { border-color: #475569; }
    html.dark .hover\:bg-gray-50:hover { background: #334155; }
    html.dark .hover\:bg-gray-100:hover { background: #475569; }
    html.dark .input { background: #0f172a; border-color: #475569; color: #e2e8f0; }
    html.dark .input:focus { border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(96,165,250,0.2); }
    html.dark .data-table thead th { background: #1e293b; color: #94a3b8; border-color: #334155; }
    html.dark .data-table tbody td { border-color: #1e293b; }
    html.dark .data-table tbody tr:hover { background: #334155; }
  </style>
</head>
<body>
  <!-- Sidebar Overlay (mobile) -->
  <div id="sidebar-overlay" class="sidebar-overlay"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <!-- Brand -->
    <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-200">
      <a href="/admin/dashboard" class="flex items-center gap-2.5">
        <img src="/logo-sdit.png" alt="Logo" class="w-9 h-9 object-contain" />
        <div>
          <span class="text-lg font-bold text-gray-900 tracking-tight">SISTER</span>
          <span class="block text-[11px] text-gray-500 -mt-0.5">Institutional Portal</span>
        </div>
      </a>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 py-3">
      {filteredGroups.map(group => {
        const isExpanded = expandedGroups.has(group.id);
        const hasActiveChild = group.children?.some(c => c.id === activeMenu);
        const isActiveGroup = group.id === activeMenu || hasActiveChild;

        if (!group.children || group.children.length === 0) {
          // Single link (Dashboard)
          return (
            <a href={group.href} class:list={['sidebar-link', isActiveGroup ? 'active' : '']}>
              <span class="material-symbols-outlined" style="font-size:20px;">{group.icon}</span>
              {group.label}
            </a>
          );
        }

        // Group with submenu
        return (
          <div class="nav-group" data-group-id={group.id}>
            <div class:list={['nav-group-header', isExpanded || isActiveGroup ? 'expanded active-group' : '']} onclick={`toggleGroup('${group.id}')`}>
              <span class="material-symbols-outlined" style="font-size:20px;">{group.icon}</span>
              <span class="flex-1">{group.label}</span>
              <span class="material-symbols-outlined chevron">expand_more</span>
            </div>
            <div class:list={['submenu', isExpanded || isActiveGroup ? 'expanded' : '']} id={`submenu-${group.id}`}>
              {group.children.map(child => (
                <a href={child.href} target={child.target || '_self'} class:list={['submenu-link', activeMenu === child.id ? 'active' : '']}>
                  <span class="dot"></span>
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </nav>

    <!-- User footer -->
    <div class="border-t border-gray-200 px-4 py-3 mt-auto">
      <div class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-gray-50 cursor-pointer" id="user-menu">
        <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">
          {(user?.name || user?.email || 'A')[0]?.toUpperCase() || 'A'}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-800 truncate">{user?.name || 'Admin'}</p>
          <p class="text-xs text-gray-500 truncate">{user?.email || ''}</p>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="main-area min-h-screen flex flex-col">
    <!-- Topbar -->
    <header class="topbar">
      <div class="flex items-center justify-between px-4 lg:px-6 h-14">
        <div class="flex items-center gap-3">
          <button id="sidebar-toggle" class="lg:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors">
            <span class="material-symbols-outlined" style="font-size:24px;">menu</span>
          </button>
          <h1 class="text-base font-semibold text-gray-800">{title}</h1>
        </div>
        <div class="flex items-center gap-2">
          <div class="relative">
            <button id="notif-btn" class="p-2 hover:bg-gray-100 rounded-lg transition-colors relative" title="Notifikasi">
              <span class="material-symbols-outlined" style="font-size:20px;">notifications</span>
              <span id="notif-badge" class="hidden absolute top-1 right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">0</span>
            </button>
            <div id="notif-dropdown" class="hidden absolute right-0 top-10 w-80 bg-white border border-gray-200 rounded-xl shadow-xl z-50 overflow-hidden">
              <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                <span class="text-sm font-semibold text-gray-800">Notifikasi</span>
                <button id="notif-mark-all" class="text-xs text-blue-600 hover:underline">Tandai semua dibaca</button>
              </div>
              <div id="notif-list" class="max-h-64 overflow-y-auto">
                <div class="px-4 py-6 text-center text-sm text-gray-400">Memuat...</div>
              </div>
            </div>
          </div>
          <button id="dark-mode-btn" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" title="Toggle Dark Mode">
            <span class="material-symbols-outlined" style="font-size:20px;">dark_mode</span>
          </button>
          <button id="logout-btn" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" title="Keluar">
            <span class="material-symbols-outlined" style="font-size:20px;">logout</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Content -->
    <main class="flex-1 p-4 lg:p-6">
      <slot />
    </main>
  </div>

  <script is:inline>
    // Sidebar toggle
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('sidebar-overlay');
    var toggle = document.getElementById('sidebar-toggle');

    if (toggle) {
      toggle.addEventListener('click', function() {
        if (sidebar) sidebar.classList.toggle('open');
        if (overlay) overlay.classList.toggle('open');
      });
    }
    if (overlay) {
      overlay.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('open');
        overlay.classList.remove('open');
      });
    }

    // Group accordion
    function toggleGroup(groupId) {
      var header = document.querySelector('[data-group-id="' + groupId + '"] .nav-group-header');
      var submenu = document.getElementById('submenu-' + groupId);
      if (header && submenu) {
        header.classList.toggle('expanded');
        submenu.classList.toggle('expanded');
      }
    }

    // Logout
    var logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async function() {
        try {
          await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'logout' }) });
        } catch (e) {}
        window.location.href = '/admin/login';
      });
    }

    // Dark Mode Toggle
    (function() {
      var darkModeBtn = document.getElementById('dark-mode-btn');
      var html = document.documentElement;
      var icon = darkModeBtn.querySelector('.material-symbols-outlined');
      
      if (localStorage.getItem('darkMode') === 'true') {
        html.classList.add('dark');
        icon.textContent = 'light_mode';
      }
      
      if (darkModeBtn) {
        darkModeBtn.addEventListener('click', function() {
          html.classList.toggle('dark');
          var isDark = html.classList.contains('dark');
          localStorage.setItem('darkMode', isDark);
          icon.textContent = isDark ? 'light_mode' : 'dark_mode';
        });
      }
    })();
  </script>
</body>
</html>
