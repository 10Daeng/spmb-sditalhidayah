---
export const prerender = false;

import { supabaseAdmin } from '../../lib/supabase.js';

const regNumber = Astro.url.searchParams.get('reg');
if (!regNumber) {
    return Astro.redirect('/spmb');
}

// Fetch site_settings
let siteSettings = null;
try {
  const { data } = await supabaseAdmin
    .from('site_settings')
    .select('*')
    .limit(1)
    .single();
  siteSettings = data;
} catch (e) {}

// Fetch registration
const { data: registration, error } = await supabaseAdmin
    .from("registrations")
    .select('*')
    .eq("registration_number", regNumber)
    .single();

if (error || !registration) {
    return new Response('Pendaftaran tidak ditemukan.', { status: 404 });
}

// Fetch student separately to avoid foreign key issues
const { data: studentData } = await supabaseAdmin
    .from("students")
    .select('*')
    .eq("registration_id", regNumber)
    .single();
    
registration.students = studentData ? [studentData] : [];

// Fetch settings for fee
let settings = null;
try {
  const { data } = await supabaseAdmin
    .from('spmb_settings')
    .select('*')
    .eq('is_active', true)
    .order('created_at', { ascending: false })
    .limit(1)
    .single();
  settings = data;
} catch (e) {}

const fee = settings?.fee_regular || 500000;
const formatRupiah = (num) => 'Rp ' + (num || 0).toLocaleString('id-ID');
const student = registration.students[0] || registration.students || {};

const formatDate = (dateStr) => {
    if (!dateStr) return '-';
    try {
        return new Date(dateStr).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        });
    } catch {
        return dateStr;
    }
};
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bukti Pendaftaran SPMB - {registration.student_full_name}</title>
    <!-- html2pdf library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            color: #333;
            line-height: 1.5;
            margin: 0;
            padding: 20px;
            background-color: #f3f4f6;
        }
        .page-container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #1e40af;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            color: #1e40af;
            text-transform: uppercase;
        }
        .header p {
            margin: 5px 0 0 0;
            color: #4b5563;
        }
        .title {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 30px;
            text-decoration: underline;
        }
        .section-title {
            font-weight: bold;
            font-size: 16px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 5px;
            margin-top: 25px;
            margin-bottom: 15px;
            color: #1f2937;
        }
        table.details {
            width: 100%;
            border-collapse: collapse;
        }
        table.details td {
            padding: 8px 0;
            vertical-align: top;
        }
        table.details td:first-child {
            width: 35%;
            color: #4b5563;
        }
        table.details td:nth-child(2) {
            width: 5%;
        }
        table.details td:last-child {
            font-weight: 600;
            color: #111827;
        }
        .info-box {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 15px;
            margin-top: 30px;
        }
        .info-box h4 {
            margin-top: 0;
            color: #1e40af;
            margin-bottom: 10px;
        }
        .info-box ul {
            margin: 0;
            padding-left: 20px;
            color: #1e3a8a;
        }
        .info-box li {
            margin-bottom: 5px;
        }
        .footer {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }
        .signature {
            text-align: center;
            width: 250px;
        }
        .signature .date {
            margin-bottom: 10px;
        }
        .signature .name {
            margin-top: 70px;
            font-weight: bold;
            text-decoration: underline;
        }
        .print-btn-container {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 20px;
        }
        .print-btn {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 10px 24px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .print-btn:hover {
            background-color: #1d4ed8;
        }
        
        @media print {
            body {
                background-color: #fff;
                padding: 0;
            }
            .page-container {
                box-shadow: none;
                padding: 0;
                margin: 0;
            }
            .print-btn-container {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="print-btn-container">
        <button class="print-btn" onclick="downloadPDF()">⬇️ Download PDF</button>
    </div>

    <div class="page-container" id="pdf-content">
        <div class="header">
            <div class="logo">
                <img src="/logo-sekolah.png" alt="Logo Sekolah" onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4MCIgaGVpZ2h0PSI4MCI+PHJlY3Qgd2lkdGg9IjgwIiBoZWlnaHQ9IjgwIiBmaWxsPSIjZTUlN2ViIi8+PHRleHQgeD0iNDAiIHk9IjQ1IiBmb250LWZhbWlseT0iYXJpYWwiIGZvbnQtc2l6ZT0iMTQiIGZpbGw9IiM2YjcyODAiIHRleHQtYW5jaG9yPSJtaWRkbGUiPkxvZ288L3RleHQ+PC9zdmc+'" />
            </div>
            <div class="header-text">
                <h1>{siteSettings?.school_name?.toUpperCase() || 'SDIT AL-HIDAYAH SUMENEP'}</h1>
                <p>Panitia Seleksi Penerimaan Murid Baru (SPMB) Tahun Ajaran {settings?.academic_year || '2026/2027'}</p>
                <p>{siteSettings?.school_address || 'Jl. Siwalan (KH. Agus Salim Gg. I), Pangarangan, Sumenep'}</p>
            </div>
        </div>

        <div class="title">BUKTI PENDAFTARAN (INDENT)</div>

        <div class="section-title">Data Registrasi</div>
        <table class="details">
            <tr>
                <td>Nomor Registrasi</td>
                <td>:</td>
                <td style="font-size: 18px; color: #1e40af;">{registration.registration_number}</td>
            </tr>
            <tr>
                <td>Tanggal Mendaftar</td>
                <td>:</td>
                <td>{formatDate(registration.created_at)}</td>
            </tr>
            <tr>
                <td>Jalur Pendaftaran</td>
                <td>:</td>
                <td style="text-transform: capitalize;">{registration.registration_path || 'Reguler'}</td>
            </tr>
        </table>

        <div class="section-title">Identitas Siswa</div>
        <table class="details">
            <tr>
                <td>Nama Lengkap</td>
                <td>:</td>
                <td>{registration.student_full_name}</td>
            </tr>
            <tr>
                <td>Jenis Kelamin</td>
                <td>:</td>
                <td>{student.gender === 'L' ? 'Laki-laki' : student.gender === 'P' ? 'Perempuan' : '-'}</td>
            </tr>
            <tr>
                <td>Tempat, Tanggal Lahir</td>
                <td>:</td>
                <td>{student.place_of_birth}, {formatDate(student.date_of_birth)}</td>
            </tr>
            <tr>
                <td>Asal Sekolah</td>
                <td>:</td>
                <td>{registration.previous_school || '-'}</td>
            </tr>
        </table>

        <div class="section-title">Data Orang Tua / Wali</div>
        <table class="details">
            <tr>
                <td>Nama Orang Tua/Wali</td>
                <td>:</td>
                <td>{registration.parent_name}</td>
            </tr>
            <tr>
                <td>No. Handphone (WhatsApp)</td>
                <td>:</td>
                <td>{registration.parent_phone}</td>
            </tr>
        </table>

        <div class="info-box">
            <h4>📋 Langkah Selanjutnya & Verifikasi</h4>
            <ul>
                <li>Simpan bukti pendaftaran ini dengan baik (dapat diunduh kembali melalui Dashboard Orang Tua).</li>
                <li><strong>Wajib:</strong> Serahkan lembar bukti pendaftaran ini beserta fotokopi dokumen asli (KK, Akta Kelahiran, Foto) ke panitia sekolah untuk <strong>Verifikasi Berkas</strong>.</li>
                <li>Membayar Biaya Pendaftaran sebesar <strong>{formatRupiah(fee)}</strong>.</li>
                <li>Pembayaran dapat dilakukan secara tunai di sekolah, atau transfer ke rekening: <strong>{settings?.bank_account || 'BSI 123456789 a.n SDIT Al-Hidayah'}</strong>.</li>
                <li>Serahkan bukti transfer/pembayaran ke panitia sekolah untuk diverifikasi oleh bagian keuangan.</li>
            </ul>
        </div>

        <div class="footer">
            <div class="signature">
                <div class="date">Sumenep, {formatDate(new Date())}</div>
                <div>Pendaftar / Orang Tua Wali,</div>
                <div class="name">{registration.parent_name}</div>
            </div>
            <div class="signature">
                <div class="date">&nbsp;</div>
                <div>Panitia SPMB,</div>
                <div class="name">Stempel & Tanda Tangan</div>
            </div>
        </div>
    </div>
    
    <script define:vars={{ regNumber: registration.registration_number }}>
        function downloadPDF() {
            const element = document.getElementById('pdf-content');
            const opt = {
                margin:       10,
                filename:     `Bukti_Pendaftaran_SPMB_${regNumber}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }

        // Auto download on load
        window.onload = function() {
            setTimeout(() => {
                downloadPDF();
            }, 500);
        };
    </script>
</body>
</html>
