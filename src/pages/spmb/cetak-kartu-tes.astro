---
export const prerender = false;

import { supabaseAdmin } from '../../lib/supabase.js';

const regNumber = Astro.url.searchParams.get('reg');
if (!regNumber) {
    return Astro.redirect('/spmb');
}

// Fetch registration & student
const { data: registration, error } = await supabaseAdmin
    .from("registrations")
    .select(`
        *,
        students (
          id,
          full_name,
          nickname,
          nik,
          place_of_birth,
          date_of_birth,
          gender,
          address_kk,
          profile_photo_url
        )
      `)
    .eq("registration_number", regNumber)
    .single();

if (error || !registration) {
    return new Response('Pendaftaran tidak ditemukan.', { status: 404 });
}

const allowedStatuses = ['calon_peserta', 'assessment', 'interview', 'scheduled', 'lulus'];
if (!allowedStatuses.includes(registration.status)) {
    return new Response('Kartu Tes belum tersedia untuk status Anda saat ini.', { status: 403 });
}

// Fetch settings
let settings = null;
try {
  const { data } = await supabaseAdmin
    .from('spmb_settings')
    .select('*')
    .eq('is_active', true)
    .limit(1)
    .single();
  settings = data;
} catch (e) {}

const student = registration.students[0] || registration.students || {};
const defaultTestDate = settings?.test_date || '-';

// Fetch site_settings
let siteSettings = null;
try {
  const { data } = await supabaseAdmin
    .from('site_settings')
    .select('*')
    .limit(1)
    .single();
  siteSettings = data;
} catch (e) {}

const formatDate = (dateStr) => {
    if (!dateStr || dateStr === '-') return '-';
    try {
        return new Date(dateStr).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        });
    } catch {
        return dateStr;
    }
};

const testDate = registration.test_date || defaultTestDate;
const testTime = registration.test_time || '08:00 - Selesai';
const testLocation = registration.test_location || siteSettings?.school_name || 'Gedung SDIT Al-Hidayah Sumenep';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kartu Peserta Tes SPMB - {registration.student_full_name}</title>
    <!-- html2pdf library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            color: #333;
            line-height: 1.5;
            margin: 0;
            padding: 20px;
            background-color: #f3f4f6;
        }
        .page-container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: relative;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #1e40af;
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header-text {
            flex-grow: 1;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 22px;
            color: #1e40af;
            text-transform: uppercase;
        }
        .header p {
            margin: 5px 0 0 0;
            color: #4b5563;
            font-size: 14px;
        }
        .title {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 30px;
            text-decoration: underline;
        }
        
        .content-wrapper {
            display: flex;
            gap: 30px;
            margin-bottom: 30px;
        }
        .photo-box {
            width: 150px;
            height: 200px;
            border: 2px solid #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #94a3b8;
            background-color: #f8fafc;
            flex-shrink: 0;
        }
        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .details-wrapper {
            flex-grow: 1;
        }

        .section-title {
            font-weight: bold;
            font-size: 16px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 5px;
            margin-bottom: 15px;
            color: #1f2937;
        }
        table.details {
            width: 100%;
            border-collapse: collapse;
        }
        table.details td {
            padding: 8px 0;
            vertical-align: top;
        }
        table.details td:first-child {
            width: 40%;
            color: #4b5563;
        }
        table.details td:nth-child(2) {
            width: 5%;
        }
        table.details td:last-child {
            font-weight: 600;
            color: #111827;
        }
        .info-box {
            background-color: #fdfaepx;
            border: 1px dashed #f59e0b;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
        }
        .info-box h4 {
            margin-top: 0;
            color: #b45309;
            margin-bottom: 10px;
        }
        .info-box ul {
            margin: 0;
            padding-left: 20px;
            color: #92400e;
            font-size: 14px;
        }
        .info-box li {
            margin-bottom: 5px;
        }
        .footer {
            margin-top: 40px;
            display: flex;
            justify-content: flex-end;
        }
        .signature {
            text-align: center;
            width: 250px;
        }
        .signature .date {
            margin-bottom: 10px;
        }
        .signature .name {
            margin-top: 70px;
            font-weight: bold;
            text-decoration: underline;
        }
        .print-btn-container {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 20px;
        }
        .print-btn {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 10px 24px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .print-btn:hover {
            background-color: #1d4ed8;
        }
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 60px;
            color: rgba(0,0,0,0.03);
            white-space: nowrap;
            pointer-events: none;
            z-index: 0;
            font-weight: bold;
        }
        .relative-z {
            position: relative;
            z-index: 10;
        }
    </style>
</head>
<body>
    <div class="print-btn-container">
        <button class="print-btn" onclick="downloadPDF()">⬇️ Download Kartu Tes (PDF)</button>
    </div>

    <div class="page-container" id="pdf-content">
        <div class="watermark">KARTU PESERTA SPMB</div>
        
        <div class="relative-z">
            <div class="header">
                <div class="header-text">
                    <h1>{siteSettings?.school_name?.toUpperCase() || 'SDIT AL-HIDAYAH SUMENEP'}</h1>
                    <p>Panitia Seleksi Penerimaan Murid Baru (SPMB) Tahun Ajaran {settings?.academic_year || '2026/2027'}</p>
                    <p>{siteSettings?.school_address || 'Jl. Siwalan (KH. Agus Salim Gg. I), Pangarangan, Sumenep'}</p>
                </div>
            </div>

            <div class="title">KARTU PESERTA TES / OBSERVASI</div>

            <div class="content-wrapper">
                <div class="photo-box">
                    {student.profile_photo_url ? (
                        <img src={student.profile_photo_url} alt="Foto Peserta" />
                    ) : (
                        <span>Pas Foto<br>3x4</span>
                    )}
                </div>
                
                <div class="details-wrapper">
                    <table class="details">
                        <tr>
                            <td>Nomor Registrasi</td>
                            <td>:</td>
                            <td style="font-size: 18px; color: #1e40af;">{registration.registration_number}</td>
                        </tr>
                        <tr>
                            <td>Nama Lengkap Peserta</td>
                            <td>:</td>
                            <td>{registration.student_full_name}</td>
                        </tr>
                        <tr>
                            <td>Jalur Pendaftaran</td>
                            <td>:</td>
                            <td style="text-transform: capitalize;">{registration.registration_path || 'Reguler'}</td>
                        </tr>
                    </table>

                    <div class="section-title" style="margin-top: 20px;">Jadwal Pelaksanaan Tes</div>
                    <table class="details">
                        <tr>
                            <td>Hari, Tanggal</td>
                            <td>:</td>
                            <td>{formatDate(testDate)}</td>
                        </tr>
                        <tr>
                            <td>Waktu Pelaksanaan</td>
                            <td>:</td>
                            <td>{testTime}</td>
                        </tr>
                        <tr>
                            <td>Lokasi Ujian/Observasi</td>
                            <td>:</td>
                            <td>{testLocation}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="info-box">
                <h4>⚠️ Tata Tertib & Ketentuan</h4>
                <ul>
                    <li>Peserta <strong>wajib membawa kartu ini</strong> saat pelaksanaan tes/observasi.</li>
                    <li>Peserta diharap hadir minimal <strong>15 menit sebelum</strong> jadwal yang telah ditentukan.</li>
                    <li>Mengenakan pakaian bebas, rapi, dan sopan (menutup aurat).</li>
                    <li>Membawa alat tulis lengkap (jika diperlukan).</li>
                </ul>
            </div>

            <div class="footer">
                <div class="signature">
                    <div class="date">Sumenep, .........................................</div>
                    <div>Ketua Panitia SPMB,</div>
                    <div class="name">Stempel & Tanda Tangan</div>
                </div>
            </div>
        </div>
    </div>
    
    <script define:vars={{ regNumber: registration.registration_number }}>
        function downloadPDF() {
            const element = document.getElementById('pdf-content');
            const opt = {
                margin:       10,
                filename:     `Kartu_Peserta_SPMB_${regNumber}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }

        // Auto download on load
        window.onload = function() {
            setTimeout(() => {
                downloadPDF();
            }, 500);
        };
    </script>
</body>
</html>
