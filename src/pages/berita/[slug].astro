---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabaseAdmin } from '../../lib/supabase.js';

const { slug } = Astro.params;

let article = null;
let relatedArticles = [];
let error = null;

try {
  let query = supabaseAdmin
    .from('articles')
    .select('*')
    .eq('status', 'published');

  // Try slug first, then id
  const { data: bySlug } = await query.eq('slug', slug).single();
  if (bySlug) {
    article = bySlug;
  } else {
    const { data: byId } = await supabaseAdmin
      .from('articles')
      .select('*')
      .eq('status', 'published')
      .eq('id', slug)
      .single();
    article = byId;
  }

  if (article) {
    const { data: related } = await supabaseAdmin
      .from('articles')
      .select('id, title, excerpt, category, slug, published_at, created_at, featured_image_url, author_name')
      .eq('status', 'published')
      .neq('id', article.id)
      .order('published_at', { ascending: false, nullsFirst: false })
      .limit(3);
    relatedArticles = related || [];
  }
} catch (e) {
  error = e.message;
}

if (!article) {
  return Astro.redirect('/berita');
}

const categoryLabels: Record<string, string> = {
  Berita: 'Berita', Pengumuman: 'Pengumuman', Prestasi: 'Prestasi', Kegiatan: 'Kegiatan', Akademik: 'Akademik', Informasi: 'Informasi'
};

const formatDate = (d: string) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<Layout title={`${article.title} - SDIT Al-Hidayah Sumenep`}>
  <section class="bg-gradient-to-r from-[#1e40af] via-[#312e81] to-[#1e1b4b]">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <a href="/berita" class="text-blue-100 hover:text-white mb-4 inline-flex items-center gap-2 text-sm">
        <span class="material-symbols-outlined" style="font-size:18px;">arrow_back</span>
        Kembali ke Daftar Berita
      </a>
      <div class="mt-4">
        <span class="inline-block px-3 py-1 bg-white/20 text-white text-xs font-semibold rounded-full uppercase tracking-wide mb-4">
          {categoryLabels[article.category] || article.category || 'Informasi'}
        </span>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">{article.title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-blue-200 text-sm mt-4">
          {article.author_name && <span>👤 {article.author_name}</span>}
          <span>📅 {formatDate(article.published_at || article.created_at)}</span>
        </div>
      </div>
    </div>
  </section>

{article.featured_image_url && (
    <div class="max-w-4xl mx-auto px-4 -mt-4">
      <img
        src={article.featured_image_url}
        alt={article.title}
        class="w-full h-64 md:h-96 object-cover rounded-xl shadow-2xl"
      />
    </div>
  )}

  <article class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600 prose-img:rounded-xl" set:html={article.content || '<p>Tidak ada konten.</p>'} />

    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-gray-500 mb-4">Bagikan artikel ini:</p>
      <div class="flex gap-3">
        <a
          href={`https://wa.me/?text=${encodeURIComponent(article.title + ' - ' + Astro.url.href)}`}
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors"
        >
          <span class="material-symbols-outlined" style="font-size:18px;">chat</span>
          WhatsApp
        </a>
        <button
          onclick={`navigator.clipboard.writeText('${Astro.url.href}');alert('Link berhasil disalin!')`}
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
        >
          <span class="material-symbols-outlined" style="font-size:18px;">link</span>
          Salin Link
        </button>
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="bg-[#f8fafc] py-12">
      <div class="max-w-6xl mx-auto px-4">
        <h3 class="text-xl font-bold text-gray-900 mb-6">Artikel Lainnya</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map(a => (
            <a href={`/berita/${a.slug || a.id}`} class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all overflow-hidden group">
              {(a.featured_image_url) ? (
                <img src={a.featured_image_url} alt="" class="w-full h-32 object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-32 bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center">
                  <span class="material-symbols-outlined text-blue-300" style="font-size:48px;">newspaper</span>
                </div>
              )}
              <div class="p-4">
                <p class="font-semibold text-gray-900 line-clamp-2 group-hover:text-[#1e40af] transition-colors">{a.title}</p>
                <p class="text-xs text-gray-400 mt-2">{formatDate(a.published_at || a.created_at)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style is:global>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>