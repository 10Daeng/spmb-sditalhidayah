---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pengaturan Role" activeMenu="roles">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Pengaturan Role</h2>
      <p class="text-sm text-gray-500 mt-0.5">Kelola role, hak akses menu, dan status aktif</p>
    </div>
    <button id="btnAddRole" class="btn btn-primary">
      <span class="material-symbols-outlined">add</span>
      Tambah Role
    </button>
  </div>

  <!-- Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="data-table min-w-[900px]">
        <thead>
          <tr>
            <th>Nama Role</th>
            <th>Label</th>
            <th>Deskripsi</th>
            <th>Hak Akses</th>
            <th class="w-28">Sistem</th>
            <th class="w-24">Aktif</th>
            <th class="w-24">Aksi</th>
          </tr>
        </thead>
        <tbody id="rolesBody">
          <tr><td colspan="7" class="text-center py-12 text-gray-400">Memuat data...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Modal -->
  <div id="addModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg max-w-md w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center">
        <h3 class="text-lg font-semibold">Tambah Role Baru</h3>
        <button onclick="closeAddModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-gray-500">close</span>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Role <span class="text-red-500">*</span></label>
          <input type="text" id="addName" class="input w-full" placeholder="contoh: editor_konten">
          <p class="text-xs text-gray-400 mt-1">Gunakan huruf kecil dan underscore</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Label <span class="text-red-500">*</span></label>
          <input type="text" id="addLabel" class="input w-full" placeholder="contoh: Editor Konten">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Deskripsi</label>
          <input type="text" id="addDescription" class="input w-full" placeholder="Deskripsi singkat role">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Hak Akses Menu</label>
          <div class="grid grid-cols-2 gap-2" id="addPermissionsWrap">
            <!-- checkboxes injected by JS -->
          </div>
        </div>
      </div>
      <div class="p-6 border-t border-gray-100 flex justify-end gap-2">
        <button onclick="closeAddModal()" class="btn bg-gray-100 text-gray-700 hover:bg-gray-200">Batal</button>
        <button onclick="saveRole()" class="btn btn-primary">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Edit Permissions Modal -->
  <div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg max-w-md w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center">
        <h3 class="text-lg font-semibold">Edit Hak Akses</h3>
        <button onclick="closeEditModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-gray-500">close</span>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <input type="hidden" id="editId" value="">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Role</label>
          <input type="text" id="editName" class="input w-full" readonly>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Label</label>
          <input type="text" id="editLabel" class="input w-full">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Deskripsi</label>
          <input type="text" id="editDescription" class="input w-full">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Hak Akses Menu</label>
          <div class="grid grid-cols-2 gap-2" id="editPermissionsWrap">
            <!-- checkboxes injected by JS -->
          </div>
        </div>
      </div>
      <div class="p-6 border-t border-gray-100 flex justify-end gap-2">
        <button onclick="closeEditModal()" class="btn bg-gray-100 text-gray-700 hover:bg-gray-200">Batal</button>
        <button onclick="updateRole()" class="btn btn-primary">Simpan Perubahan</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
    <span id="toastIcon" class="material-symbols-outlined">check_circle</span>
    <span id="toastMsg"></span>
  </div>
</AdminLayout>

<script is:inline>
let allRoles = [];

const permissionOptions = [
  { id: 'dashboard', label: 'Dashboard' },
  { id: 'spmb', label: 'SPMB' },
  { id: 'keuangan', label: 'Keuangan' },
  { id: 'akademik', label: 'Akademik' },
  { id: 'konten', label: 'Konten' },
  { id: 'laporan', label: 'Laporan' },
  { id: 'sistem', label: 'Sistem' },
  { id: 'users', label: 'Users' },
  { id: 'roles', label: 'Roles' },
];

function renderPermissionCheckboxes(containerId, selectedIds) {
  const container = document.getElementById(containerId);
  selectedIds = selectedIds || [];
  container.innerHTML = permissionOptions.map(p => {
    const checked = selectedIds.includes(p.id) ? 'checked' : '';
    return `<label class="flex items-center gap-2 p-2 rounded-lg border border-gray-100 hover:bg-gray-50 cursor-pointer">
      <input type="checkbox" value="${p.id}" ${checked} class="perm-checkbox w-4 h-4 rounded border-gray-300 text-blue-600">
      <span class="text-sm text-gray-700">${p.label}</span>
    </label>`;
  }).join('');
}

function getSelectedPermissions(containerId) {
  const container = document.getElementById(containerId);
  const checkboxes = container.querySelectorAll('.perm-checkbox:checked');
  return Array.from(checkboxes).map(cb => cb.value);
}

async function loadRoles() {
  const tbody = document.getElementById('rolesBody');
  tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Memuat data...</td></tr>';

  try {
    const res = await fetch('/api/admin/roles', { credentials: 'include' });
    const result = await res.json();

    if (result.success) {
      allRoles = result.data || [];
      renderTable();
    } else {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Gagal memuat data</td></tr>';
    }
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Terjadi kesalahan</td></tr>';
  }
}

function renderTable() {
  const tbody = document.getElementById('rolesBody');

  if (!allRoles.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Tidak ada data</td></tr>';
    return;
  }

  tbody.innerHTML = allRoles.map(role => {
    const perms = role.permissions || [];
    const permBadges = perms.length
      ? perms.map(p => `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-blue-50 text-blue-600 border border-blue-100 mr-1 mb-1">${p}</span>`).join('')
      : '<span class="text-xs text-gray-400">-</span>';

    const systemBadge = role.is_system
      ? '<span class="badge bg-purple-50 text-purple-600 text-xs">System</span>'
      : '<span class="badge bg-gray-50 text-gray-500 text-xs">Custom</span>';

    const activeToggle = `<div class="toggle ${role.is_active ? 'active' : ''}" onclick="toggleActive('${role.id}', ${!role.is_active})" title="${role.is_active ? 'Nonaktifkan' : 'Aktifkan'}"></div>`;

    const canEdit = true;
    const canDelete = !role.is_system;

    const actions = [];
    if (canEdit) {
      actions.push(`<button onclick="openEditModal('${role.id}')" class="w-8 h-8 rounded-lg hover:bg-blue-50 text-blue-600 flex items-center justify-center" title="Edit"><span class="material-symbols-outlined" style="font-size:18px;">edit</span></button>`);
    }
    if (canDelete) {
      actions.push(`<button onclick="deleteRole('${role.id}')" class="w-8 h-8 rounded-lg hover:bg-red-50 text-red-500 flex items-center justify-center" title="Hapus"><span class="material-symbols-outlined" style="font-size:18px;">delete</span></button>`);
    }

    return `<tr class="hover:bg-gray-50 transition-colors">
      <td class="font-medium text-sm text-gray-900">${role.name}</td>
      <td class="text-sm text-gray-600">${role.label || '-'}</td>
      <td class="text-sm text-gray-500 max-w-xs truncate">${role.description || '-'}</td>
      <td class="flex flex-wrap">${permBadges}</td>
      <td>${systemBadge}</td>
      <td>${activeToggle}</td>
      <td>
        <div class="flex gap-1">
          ${actions.join('')}
        </div>
      </td>
    </tr>`;
  }).join('');
}

// Toggle is_active
async function toggleActive(id, newState) {
  try {
    const res = await fetch('/api/admin/roles', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ id, is_active: newState })
    });
    const result = await res.json();
    if (result.success) {
      showToast(newState ? 'Role diaktifkan' : 'Role dinonaktifkan');
      loadRoles();
    } else {
      showToast(result.error || 'Gagal mengubah status', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Add Modal
document.getElementById('btnAddRole').addEventListener('click', () => {
  renderPermissionCheckboxes('addPermissionsWrap', []);
  document.getElementById('addModal').classList.remove('hidden');
});

function closeAddModal() {
  document.getElementById('addModal').classList.add('hidden');
  document.getElementById('addName').value = '';
  document.getElementById('addLabel').value = '';
  document.getElementById('addDescription').value = '';
}

async function saveRole() {
  const name = document.getElementById('addName').value.trim();
  const label = document.getElementById('addLabel').value.trim();
  const description = document.getElementById('addDescription').value.trim();
  const permissions = getSelectedPermissions('addPermissionsWrap');

  if (!name || !label) {
    showToast('Nama dan label role wajib diisi', 'error');
    return;
  }

  try {
    const res = await fetch('/api/admin/roles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ name, label, description, permissions })
    });
    const result = await res.json();
    if (result.success) {
      showToast('Role berhasil ditambahkan');
      closeAddModal();
      loadRoles();
    } else {
      showToast(result.error || 'Gagal menambahkan role', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Edit Modal
function openEditModal(id) {
  const role = allRoles.find(r => r.id === id);
  if (!role) return;

  document.getElementById('editId').value = role.id;
  document.getElementById('editName').value = role.name;
  document.getElementById('editLabel').value = role.label || '';
  document.getElementById('editDescription').value = role.description || '';
  renderPermissionCheckboxes('editPermissionsWrap', role.permissions);
  document.getElementById('editModal').classList.remove('hidden');
}

function closeEditModal() {
  document.getElementById('editModal').classList.add('hidden');
}

async function updateRole() {
  const id = document.getElementById('editId').value;
  const label = document.getElementById('editLabel').value.trim();
  const description = document.getElementById('editDescription').value.trim();
  const permissions = getSelectedPermissions('editPermissionsWrap');

  if (!label) {
    showToast('Label role wajib diisi', 'error');
    return;
  }

  try {
    const res = await fetch('/api/admin/roles', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ id, label, description, permissions })
    });
    const result = await res.json();
    if (result.success) {
      showToast('Role berhasil diupdate');
      closeEditModal();
      loadRoles();
    } else {
      showToast(result.error || 'Gagal mengupdate role', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Delete
async function deleteRole(id) {
  const role = allRoles.find(r => r.id === id);
  const name = role ? role.name : 'Role ini';
  if (!confirm(`Hapus "${name}"? Tindakan tidak bisa dibatalkan.`)) return;

  try {
    const res = await fetch(`/api/admin/roles?id=${id}`, {
      method: 'DELETE',
      credentials: 'include'
    });
    const result = await res.json();
    if (result.success) {
      showToast('Role dihapus');
      loadRoles();
    } else {
      showToast(result.error || 'Gagal menghapus', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Toast
function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toastIcon').textContent = type === 'error' ? 'error' : 'check_circle';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

loadRoles();
</script>
