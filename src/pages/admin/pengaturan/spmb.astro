---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pengaturan SPMB" activeMenu="spmb-settings">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Pengaturan SPMB</h2>
      <p class="text-sm text-gray-500 mt-0.5">Atur jadwal, biaya, kuota, dan persyaratan SPMB</p>
    </div>
    <button id="btnSave" class="btn btn-primary">
      <span class="material-symbols-outlined">save</span>
      Simpan Perubahan
    </button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Jadwal -->
    <div class="card p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-blue-500">calendar_month</span>
        <h3 class="font-semibold text-gray-900">Jadwal SPMB</h3>
      </div>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tahun Ajaran</label>
          <input type="text" id="academicYear" class="input w-full" value="2026/2027">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Indent Mulai</label>
            <input type="date" id="regStart" class="input w-full">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Indent Selesai</label>
            <input type="date" id="regEnd" class="input w-full">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tes Masuk</label>
          <input type="text" id="testDate" class="input w-full" placeholder="Juli 2026">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Pengumuman</label>
          <input type="text" id="announceDate" class="input w-full" placeholder="Agustus 2026">
        </div>
      </div>
    </div>

    <!-- Biaya -->
    <div class="card p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-emerald-500">payments</span>
        <h3 class="font-semibold text-gray-900">Biaya Pendaftaran</h3>
      </div>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Jalur Reguler (Rp)</label>
          <input type="number" id="feeRegular" class="input w-full" placeholder="500000">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Jalur Khusus / Indent (Rp)</label>
          <input type="number" id="feeIndent" class="input w-full" placeholder="0">
          <p class="text-xs text-gray-400 mt-1">Isi 0 untuk Gratis</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Info Rekening Pembayaran</label>
          <input type="text" id="bankAccount" class="input w-full" placeholder="BSI: 123456789 a.n SDIT Al-Hidayah">
          <p class="text-xs text-gray-400 mt-1">Ditampilkan pada Parent Dashboard & Bukti Cetak</p>
        </div>
      </div>
    </div>

    <!-- Kuota -->
    <div class="card p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-purple-500">groups</span>
        <h3 class="font-semibold text-gray-900">Kuota Siswa</h3>
      </div>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Kelas 1 (siswa)</label>
          <input type="number" id="quotaClass1" class="input w-full" placeholder="120">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Kelas 2-6</label>
          <input type="text" id="quotaOther" class="input w-full" placeholder="Sesuai ketersediaan">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Maksimal per Kelas</label>
          <input type="number" id="maxPerClass" class="input w-full" placeholder="30">
        </div>
      </div>
    </div>

    <!-- Kontak -->
    <div class="card p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-amber-500">contact_phone</span>
        <h3 class="font-semibold text-gray-900">Kontak SPMB</h3>
      </div>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Telepon</label>
          <input type="text" id="contactPhone" class="input w-full" placeholder="(0328) 123456">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
          <input type="text" id="contactWa" class="input w-full" placeholder="08123456789">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="contactEmail" class="input w-full" placeholder="info@sditalhidayah.sch.id">
        </div>
      </div>
    </div>

    <!-- Persyaratan -->
    <div class="card p-6 lg:col-span-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-rose-500">description</span>
        <h3 class="font-semibold text-gray-900">Persyaratan Indent (HTML)</h3>
      </div>
      <textarea id="requirementsHtml" rows="8" class="input w-full font-mono text-sm" placeholder="<ul><li>Syarat 1</li><li>Syarat 2</li></ul>"></textarea>
      <p class="text-xs text-gray-400 mt-2">Gunakan tag HTML untuk formatting (ul, li, strong, dll)</p>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
    <span id="toastIcon" class="material-symbols-outlined">check_circle</span>
    <span id="toastMsg"></span>
  </div>
</AdminLayout>

<script is:inline>
async function loadSettings() {
  try {
    const res = await fetch('/api/admin/spmb-settings', { credentials: 'include' });
    const result = await res.json();
    if (result.data) {
      const d = result.data;
      document.getElementById('academicYear').value = d.academic_year || '2026/2027';
      document.getElementById('regStart').value = d.registration_start || '';
      document.getElementById('regEnd').value = d.registration_end || '';
      document.getElementById('testDate').value = d.test_date || '';
      document.getElementById('announceDate').value = d.announcement_date || '';
      document.getElementById('feeRegular').value = d.fee_regular || '';
      document.getElementById('feeIndent').value = d.fee_indent || '';
      document.getElementById('quotaClass1').value = d.quota_class1 || '';
      document.getElementById('quotaOther').value = d.quota_other_classes || '';
      document.getElementById('maxPerClass').value = d.max_per_class || '';
      document.getElementById('contactPhone').value = d.contact_phone || '';
      document.getElementById('contactWa').value = d.contact_whatsapp || '';
      document.getElementById('contactEmail').value = d.contact_email || '';
      document.getElementById('bankAccount').value = d.bank_account || '';
      document.getElementById('requirementsHtml').value = d.requirements_html || '';
    }
  } catch (e) {}
}

document.getElementById('btnSave').addEventListener('click', async () => {
  const body = {
    academic_year: document.getElementById('academicYear').value,
    registration_start: document.getElementById('regStart').value || null,
    registration_end: document.getElementById('regEnd').value || null,
    test_date: document.getElementById('testDate').value,
    announcement_date: document.getElementById('announceDate').value,
    fee_regular: document.getElementById('feeRegular').value,
    fee_indent: document.getElementById('feeIndent').value,
    quota_class1: document.getElementById('quotaClass1').value,
    quota_other_classes: document.getElementById('quotaOther').value,
    max_per_class: document.getElementById('maxPerClass').value,
    contact_phone: document.getElementById('contactPhone').value,
    contact_whatsapp: document.getElementById('contactWa').value,
    contact_email: document.getElementById('contactEmail').value,
    bank_account: document.getElementById('bankAccount').value,
    requirements_html: document.getElementById('requirementsHtml').value
  };

  try {
    const res = await fetch('/api/admin/spmb-settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(body)
    });
    const result = await res.json();
    if (result.success) {
      showToast('Pengaturan SPMB disimpan');
    } else {
      showToast(result.error || 'Gagal menyimpan', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
});

function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toastIcon').textContent = type === 'error' ? 'error' : 'check_circle';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

loadSettings();
</script>