---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Template Pengumuman" activeMenu="template-pengumuman">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Template Pengumuman</h2>
      <p class="text-sm text-gray-500 mt-0.5">Atur template surat pengumuman hasil seleksi</p>
    </div>
  </div>

  <div class="card p-12 text-center">
    <div class="w-16 h-16 rounded-2xl bg-violet-50 flex items-center justify-center mx-auto mb-4">
      <span class="material-symbols-outlined text-violet-500" style="font-size:32px;">description</span>
    </div>
    <h3 class="text-lg font-semibold text-gray-800 mb-2">Modul Template Pengumuman</h3>
    <p class="text-gray-500 max-w-md mx-auto mb-4">Atur field-field yang tampil di surat pengumuman hasil seleksi (lulus/tidak lulus).</p>
    <p class="text-xs text-gray-400">Fitur: Pilih field, atur urutan, preview PDF, generate surat per siswa</p>
  </div>
</AdminLayout>