---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Belum Lunas" activeMenu="belum-bayar">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Belum Lunas</h2>
      <p class="text-sm text-gray-500 mt-0.5">Daftar pendaftar yang belum melunasi pembayaran</p>
    </div>
    <button id="btnReminder" class="btn btn-primary">
      <span class="material-symbols-outlined">notifications_active</span>
      Kirim Reminder
    </button>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="data-table min-w-[900px]">
        <thead>
          <tr>
            <th>No. Pendaftaran</th>
            <th>Nama Siswa</th>
            <th>Jenis</th>
            <th>Nominal</th>
            <th>Dibayar</th>
            <th>Kurang</th>
            <th>Jatuh Tempo</th>
            <th class="w-10">Aksi</th>
          </tr>
        </thead>
        <tbody id="paymentsBody">
          <tr><td colspan="8" class="text-center py-12 text-gray-400">Memuat data...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-gray-100 gap-3" id="pagination">
      <p class="text-xs text-gray-500" id="pageInfo">Menampilkan 0 - 0 dari 0</p>
      <div class="flex items-center gap-2" id="pageControls"></div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
    <span id="toastIcon" class="material-symbols-outlined">check_circle</span>
    <span id="toastMsg"></span>
  </div>
</AdminLayout>

<script is:inline>
let currentPage = 1;
let currentData = [];

const typeLabels = {
  pendaftaran: 'Indent',
  daftar_ulang: 'Daftar Ulang',
  spp: 'SPP',
  lainnya: 'Lainnya'
};

function formatRupiah(num) {
  return 'Rp ' + (num || 0).toLocaleString('id-ID');
}

async function loadPayments(page = 1) {
  currentPage = page;
  const tbody = document.getElementById('paymentsBody');
  tbody.innerHTML = '<tr><td colspan="8" class="text-center py-12 text-gray-400">Memuat data...</td></tr>';

  try {
    const res = await fetch(`/api/admin/payments?status=pending&page=${page}&limit=50`, { credentials: 'include' });
    const result = await res.json();

    if (result.success) {
      // Also fetch partial payments
      const res2 = await fetch(`/api/admin/payments?status=partial&page=1&limit=1000`, { credentials: 'include' });
      const result2 = await res2.json();
      const partialData = result2.success ? (result2.data || []) : [];

      currentData = [...result.data, ...partialData];

      document.getElementById('pageInfo').textContent = `Menampilkan ${currentData.length} tagihan belum lunas`;
      renderTable(currentData);
      document.getElementById('pageControls').innerHTML = '';
    } else {
      tbody.innerHTML = '<tr><td colspan="8" class="text-center py-12 text-gray-400">Gagal memuat data</td></tr>';
    }
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-12 text-gray-400">Terjadi kesalahan</td></tr>';
  }
}

function renderTable(data) {
  const tbody = document.getElementById('paymentsBody');
  if (!data.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-12 text-gray-400">Tidak ada tagihan belum lunas</td></tr>';
    return;
  }

  tbody.innerHTML = data.map(p => {
    const reg = p.registration || {};
    const kurang = (p.amount || 0) - (p.paid_amount || 0);
    const due = p.due_date ? new Date(p.due_date).toLocaleDateString('id-ID') : '-';
    const isOverdue = p.due_date && new Date(p.due_date) < new Date() && p.status !== 'paid';
    return `<tr class="hover:bg-gray-50 transition-colors">
      <td class="font-mono text-xs">${reg.registration_number || '-'}</td>
      <td>
        <div class="font-medium text-sm text-gray-900">${reg.student_full_name || '-'}</div>
        <div class="text-xs text-gray-400">${reg.parent_phone || ''}</div>
      </td>
      <td><span class="text-xs text-gray-600">${typeLabels[p.payment_type] || p.payment_type}</span></td>
      <td class="font-medium text-sm">${formatRupiah(p.amount)}</td>
      <td class="text-sm text-gray-700">${formatRupiah(p.paid_amount)}</td>
      <td class="text-sm font-bold ${kurang > 0 ? 'text-rose-600' : 'text-emerald-600'}">${formatRupiah(kurang)}</td>
      <td class="text-xs ${isOverdue ? 'text-red-500 font-medium' : 'text-gray-500'}">${due} ${isOverdue ? '(Jatuh Tempo)' : ''}</td>
      <td>
        <button onclick="window.location.href='/admin/pembayaran'" class="w-8 h-8 rounded-lg hover:bg-blue-50 text-blue-600 flex items-center justify-center" title="Konfirmasi">
          <span class="material-symbols-outlined" style="font-size:18px;">open_in_new</span>
        </button>
      </td>
    </tr>`;
  }).join('');
}

document.getElementById('btnReminder').addEventListener('click', () => {
  showToast('Reminder dikirim ke ' + currentData.length + ' pendaftar');
});

function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toastIcon').textContent = type === 'error' ? 'error' : 'check_circle';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

loadPayments();
</script>