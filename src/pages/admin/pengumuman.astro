        ${hasUrl ? `<a href="${url}" target="_blank" class="btn bg-blue-50 text-blue-600 hover:bg-blue-100 text-xs py-1.5 px-3"><span class="material-symbols-outlined" style="font-size:16px;">visibility</span> Lihat</a>` : '<span class="text-xs text-gray-400 px-3">-</span>'}
