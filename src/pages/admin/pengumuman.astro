function renderTabPembayaran(payments, paySummary) {
  const ps = paySummary || { total_due: 0, total_paid: 0, remaining: 0, status: 'belum_bayar' };
  const st = ps.status === 'lunas' ? { text: 'Lunas', class: 'bg-emerald-50 text-emerald-600' } :
             ps.status === 'partial' ? { text: 'Kurang Bayar', class: 'bg-amber-50 text-amber-600' } :
             { text: 'Belum Bayar', class: 'bg-gray-50 text-gray-500' };

  let rows = '';
  if (!payments.length) {
    rows = '<tr><td colspan="6" class="text-center py-6 text-gray-400 text-sm">Belum ada tagihan</td></tr>';
  } else {
    rows = payments.map(p => {
      const pst = statusConfig[p.status] || { text: p.status, class: 'bg-gray-50 text-gray-600' };
      return `<tr class="border-b border-gray-50">
        <td class="py-2 text-sm">${p.payment_type === 'pendaftaran' ? 'Indent' : p.payment_type === 'daftar_ulang' ? 'Daftar Ulang' : p.payment_type === 'spp' ? 'SPP' : p.payment_type}</td>
        <td class="py-2 text-sm font-medium">${formatRupiah(p.amount)}</td>
        <td class="py-2 text-sm">${formatRupiah(p.paid_amount)}</td>
        <td class="py-2 text-sm">${formatRupiah(Math.max(0, p.amount - p.paid_amount))}</td>
        <td class="py-2"><span class="badge ${pst.class} text-xs">${pst.text}</span></td>
        <td class="py-2 text-xs text-gray-500">${formatDate(p.created_at)}</td>
      </tr>`;
    }).join('');
  }

  return `
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card p-4 bg-blue-50 border-blue-100">
          <p class="text-xs text-blue-500 mb-1">Total Tagihan</p>
          <p class="text-lg font-bold text-blue-700">${formatRupiah(ps.total_due)}</p>
        </div>
        <div class="card p-4 bg-emerald-50 border-emerald-100">
          <p class="text-xs text-emerald-500 mb-1">Total Dibayar</p>
          <p class="text-lg font-bold text-emerald-700">${formatRupiah(ps.total_paid)}</p>
        </div>
        <div class="card p-4 ${ps.remaining > 0 ? 'bg-rose-50 border-rose-100' : 'bg-gray-50 border-gray-100'}">
          <p class="text-xs ${ps.remaining > 0 ? 'text-rose-500' : 'text-gray-500'} mb-1">Sisa</p>
          <p class="text-lg font-bold ${ps.remaining > 0 ? 'text-rose-700' : 'text-gray-700'}">${formatRupiah(ps.remaining)}</p>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <h4 class="font-semibold text-sm text-gray-900">Riwayat Pembayaran</h4>
        <span class="badge ${st.class} text-xs">${st.text}</span>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table w-full">
          <thead>
            <tr><th>Jenis</th><th>Nominal</th><th>Dibayar</th><th>Kurang</th><th>Status</th><th>Tanggal</th></tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    </div>
  `;
}

function renderTabRiwayat(logs) {
  if (!logs.length) {
    return '<div class="text-center py-8 text-gray-400 text-sm">Belum ada riwayat aktivitas</div>';
  }

  const actionLabels = {
    'VERIFY_REGISTRATION_APPROVED': { text: 'Indent Disetujui', icon: 'check_circle', color: 'text-emerald-600' },
    'VERIFY_REGISTRATION_REJECTED': { text: 'Indent Ditolak', icon: 'cancel', color: 'text-rose-600' },
    'UPDATE_REGISTRATION': { text: 'Data Diperbarui', icon: 'edit', color: 'text-blue-600' },
    'SCHEDULE_TEST': { text: 'Jadwal Tes Diatur', icon: 'event', color: 'text-blue-600' },
    'ANNOUNCE_RESULT': { text: 'Hasil Diumumkan', icon: 'campaign', color: 'text-purple-600' }
  };

  const rows = logs.map(l => {
    const act = actionLabels[l.action] || { text: l.action, icon: 'info', color: 'text-gray-600' };
    return `<div class="flex gap-3 pb-4 border-b border-gray-50 last:border-0">
      <div class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined ${act.color}" style="font-size:18px;">${act.icon}</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-900">${act.text}</p>
        <p class="text-xs text-gray-500">${formatDateTime(l.created_at)}</p>
        ${l.details ? `<p class="text-xs text-gray-400 mt-1">${JSON.stringify(l.details).slice(0, 120)}</p>` : ''}
      </div>
    </div>`;
  }).join('');

  return `<div class="space-y-4">${rows}</div>`;
}

function renderActions(reg) {
  const actions = document.getElementById('modalActions');
  let html = '';

  if (reg.status === 'interview' || reg.status === 'cadangan') {
    html += `<button onclick="openResultModal('${reg.id}')" class="btn btn-primary"><span class="material-symbols-outlined">campaign</span> Umumkan Hasil</button>`;
  }
  
  html += `<a href="/api/exam-card/${reg.id}" target="_blank" class="btn bg-gray-100 text-gray-700 hover:bg-gray-200"><span class="material-symbols-outlined">download</span> Kartu Ujian</a>`;

  actions.innerHTML = html;
}

// ========================
// ACTIONS
