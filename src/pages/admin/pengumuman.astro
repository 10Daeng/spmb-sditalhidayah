async function handleApprove(id) {
  if (!confirm('Terima dan verifikasi Indent ini?')) return;
  try {
    const res = await fetch('/api/admin/registrations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action: 'approve', registrationId: id })
    });
    const result = await res.json();
    if (result.success) {
      showToast(result.message || 'Indent diverifikasi');
      closeDetailModal();
      loadRegistrations();
    } else {
      showToast(result.error || 'Gagal', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

async function handleSetCalonPeserta(id) {
  if (!confirm('Tetapkan sebagai Calon Peserta?')) return;
  try {
    const res = await fetch('/api/admin/registrations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action: 'set_calon_peserta', registrationId: id })
    });
    const result = await res.json();
    if (result.success) {
      showToast(result.message || 'Ditetapkan sebagai Calon Peserta');
      closeDetailModal();
      loadRegistrations();
    } else {
      showToast(result.error || 'Gagal', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

function openRejectModal(id) {
  const reg = allData.find(r => r.id === id);
  if (!reg) return;
  document.getElementById('rejectStudentName').textContent = reg.student_full_name || '-';
  document.getElementById('rejectReason').value = '';
  document.getElementById('rejectModal').classList.remove('hidden');
}
function closeRejectModal() { document.getElementById('rejectModal').classList.add('hidden'); }

async function submitReject() {
  const reason = document.getElementById('rejectReason').value.trim();
  if (!reason) { showToast('Alasan wajib diisi', 'error'); return; }
  if (!currentDetailId) return;

  try {
    const res = await fetch('/api/admin/registrations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action: 'reject', registrationId: currentDetailId, reason })
    });
    const result = await res.json();
    if (result.success) {
      showToast('Indent ditolak');
      closeRejectModal();
      closeDetailModal();
      loadRegistrations();
    } else {
      showToast(result.error || 'Gagal', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

function openScheduleModal(id) {
  const reg = allData.find(r => r.id === id);
  if (!reg) return;
  document.getElementById('scheduleStudentName').textContent = reg.student_full_name || '-';
  document.getElementById('schDate').value = '';
  document.getElementById('schTime').value = '';
  document.getElementById('schLocation').value = '';
  document.getElementById('scheduleModal').classList.remove('hidden');
}
function closeScheduleModal() { document.getElementById('scheduleModal').classList.add('hidden'); }

async function submitSchedule() {
  const testDate = document.getElementById('schDate').value;
  const testTime = document.getElementById('schTime').value;
  const testLocation = document.getElementById('schLocation').value;
  if (!testDate || !testTime) { showToast('Tanggal dan waktu wajib diisi', 'error'); return; }

  try {
    const res = await fetch('/api/admin/registrations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action: 'schedule', registrationId: currentDetailId, testDate, testTime, testLocation })
    });
    const result = await res.json();
    if (result.success) {
      showToast('Jadwal tes disimpan');
      closeScheduleModal();
      closeDetailModal();
      loadRegistrations();
    } else {
      showToast(result.error || 'Gagal', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

function openResultModal(id) {
  const reg = allData.find(r => r.id === id);
  if (!reg) return;
  document.getElementById('resultStudentName').textContent = reg.student_full_name || '-';
  document.getElementById('resultPassed').value = 'true';
  document.getElementById('resultScore').value = '';
  document.getElementById('resultModal').classList.remove('hidden');
}
function closeResultModal() { document.getElementById('resultModal').classList.add('hidden'); }

async function submitResult() {
  const passed = document.getElementById('resultPassed').value === 'true';
  const testScore = document.getElementById('resultScore').value;
  if (!currentDetailId) return;

  try {
    const res = await fetch('/api/admin/registrations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action: 'result', registrationId: currentDetailId, passed, testScore })
    });
    const result = await res.json();
    if (result.success) {
      showToast(passed ? 'Siswa dinyatakan LULUS' : 'Siswa dinyatakan TIDAK LULUS');
      closeResultModal();
      closeDetailModal();
      loadRegistrations();
    } else {
      showToast(result.error || 'Gagal', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// ========================
// UTILS
// ========================
function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toastIcon').textContent = type === 'error' ? 'error' : 'check_circle';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

// Event listeners
document.getElementById('btnRefresh').addEventListener('click', loadRegistrations);
document.getElementById('btnFilter').addEventListener('click', applyFilters);
document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('statusFilter').addEventListener('change', applyFilters);
document.getElementById('sortFilter').addEventListener('change', applyFilters);

// Close modals on backdrop click
['detailModal', 'scheduleModal', 'resultModal', 'rejectModal'].forEach(id => {
  document.getElementById(id).addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      if (id === 'detailModal') closeDetailModal();
      if (id === 'scheduleModal') closeScheduleModal();
      if (id === 'resultModal') closeResultModal();
      if (id === 'rejectModal') closeRejectModal();
    }
  });
});

// Init
loadRegistrations();
</script>