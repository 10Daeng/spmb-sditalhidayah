function renderTabDokumen(reg, student, docSummary) {
  const docUrls = student?.document_urls || {};
  const docs = docSummary || { uploaded: 0, required: 4, complete: false, missing: [] };

  let docList = '';
  Object.entries(docLabels).forEach(([key, label]) => {
    const url = docUrls[key];
    const hasUrl = url && String(url).startsWith('http');
    docList += `
      <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined ${hasUrl ? 'text-emerald-500' : 'text-gray-300'}" style="font-size:20px;">${hasUrl ? 'check_circle' : 'radio_button_unchecked'}</span>
          <div>
            <p class="text-sm font-medium text-gray-700">${label}</p>
            <p class="text-xs text-gray-400">${hasUrl ? 'Sudah diunggah' : 'Belum diunggah'}</p>
