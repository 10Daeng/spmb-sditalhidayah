---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Alur Indent" activeMenu="alur">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Alur Indent</h2>
      <p class="text-sm text-gray-500 mt-0.5">Atur informasi alur Indent yang tampil di website</p>
    </div>
  </div>

  <div class="card p-12 text-center">
    <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-4">
      <span class="material-symbols-outlined text-indigo-500" style="font-size:32px;">timeline</span>
    </div>
    <h3 class="text-lg font-semibold text-gray-800 mb-2">Modul Alur Indent</h3>
    <p class="text-gray-500 max-w-md mx-auto mb-4">Atur langkah-langkah alur Indent yang tampil di halaman informasi SPMB.</p>
    <p class="text-xs text-gray-400">Fitur: Edit langkah, upload icon, atur urutan, preview</p>
  </div>
</AdminLayout>