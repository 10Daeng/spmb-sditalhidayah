---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Jadwal Indent" activeMenu="jadwal-info">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Jadwal Indent</h2>
      <p class="text-sm text-gray-500 mt-0.5">Atur jadwal dan timeline SPMB</p>
    </div>
  </div>

  <div class="card p-12 text-center">
    <div class="w-16 h-16 rounded-2xl bg-teal-50 flex items-center justify-center mx-auto mb-4">
      <span class="material-symbols-outlined text-teal-500" style="font-size:32px;">event_note</span>
    </div>
    <h3 class="text-lg font-semibold text-gray-800 mb-2">Modul Jadwal Indent</h3>
    <p class="text-gray-500 max-w-md mx-auto mb-4">Atur tanggal-tanggal penting dalam proses SPMB yang tampil di landing page.</p>
    <p class="text-xs text-gray-400">Fitur: Edit jadwal, tanggal mulai/selesai, deskripsi, tampil di landing page</p>
  </div>
</AdminLayout>