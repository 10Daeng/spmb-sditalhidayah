---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Syarat Pendaftaran" activeMenu="syarat">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Syarat Pendaftaran</h2>
      <p class="text-sm text-gray-500 mt-0.5">Atur persyaratan pendaftaran yang tampil di website</p>
    </div>
  </div>

  <div class="card p-12 text-center">
    <div class="w-16 h-16 rounded-2xl bg-cyan-50 flex items-center justify-center mx-auto mb-4">
      <span class="material-symbols-outlined text-cyan-500" style="font-size:32px;">checklist</span>
    </div>
    <h3 class="text-lg font-semibold text-gray-800 mb-2">Modul Syarat Pendaftaran</h3>
    <p class="text-gray-500 max-w-md mx-auto mb-4">Atur daftar persyaratan dan dokumen yang diperlukan untuk pendaftaran.</p>
    <p class="text-xs text-gray-400">Fitur: Edit syarat, rich text editor, gambar, tampil di landing page</p>
  </div>
</AdminLayout>