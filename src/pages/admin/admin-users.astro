---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Data Admin" activeMenu="admin-users">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-gray-900">Data Admin</h2>
      <p class="text-sm text-gray-500 mt-0.5">Kelola pengguna admin dan akses role</p>
    </div>
    <button id="btnAddAdmin" class="btn btn-primary hidden">
      <span class="material-symbols-outlined">person_add</span>
      Tambah Admin
    </button>
  </div>

  <!-- Summary -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6" id="statsRow">
    <div class="card p-5">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
          <span class="material-symbols-outlined text-blue-500" style="font-size:20px;">shield_person</span>
        </div>
        <div>
          <p class="text-xs text-gray-500">Total Admin</p>
          <p class="text-lg font-bold text-gray-900" id="statTotal">0</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center">
          <span class="material-symbols-outlined text-purple-500" style="font-size:20px;">admin_panel_settings</span>
        </div>
        <div>
          <p class="text-xs text-gray-500">Super Admin</p>
          <p class="text-lg font-bold text-gray-900" id="statSuper">0</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
          <span class="material-symbols-outlined text-emerald-500" style="font-size:20px;">check_circle</span>
        </div>
        <div>
          <p class="text-xs text-gray-500">Aktif</p>
          <p class="text-lg font-bold text-gray-900" id="statActive">0</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card p-4 mb-4">
    <div class="flex flex-col sm:flex-row gap-3 items-end">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-gray-500 mb-1">Cari</label>
        <input type="text" id="searchInput" class="input w-full" placeholder="Nama, email...">
      </div>
      <div class="min-w-[160px]">
        <label class="block text-xs font-medium text-gray-500 mb-1">Role</label>
        <select id="roleFilter" class="input w-full">
          <option value="">Semua Role</option>
        </select>
      </div>
      <button id="btnFilter" class="btn btn-primary">
        <span class="material-symbols-outlined" style="font-size:18px;">filter_list</span>
        Filter
      </button>
    </div>
  </div>

  <!-- Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="data-table min-w-[900px]">
        <thead>
          <tr>
            <th>Nama</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Terakhir Login</th>
            <th>Aktivitas Terakhir</th>
            <th class="w-24">Aksi</th>
          </tr>
        </thead>
        <tbody id="usersBody">
          <tr><td colspan="7" class="text-center py-12 text-gray-400">Memuat data...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-gray-100 gap-3" id="pagination">
      <p class="text-xs text-gray-500" id="pageInfo">Menampilkan 0 - 0 dari 0</p>
      <div class="flex items-center gap-2" id="pageControls"></div>
    </div>
  </div>

  <!-- Add Modal -->
  <div id="addModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg max-w-md w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center">
        <h3 class="text-lg font-semibold">Tambah Admin Baru</h3>
        <button onclick="closeAddModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-gray-500">close</span>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
          <input type="text" id="addName" class="input w-full" placeholder="Nama admin">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
          <input type="email" id="addEmail" class="input w-full" placeholder="Masukkan email Anda">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password <span class="text-red-500">*</span></label>
          <input type="password" id="addPassword" class="input w-full" placeholder="Minimal 6 karakter">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role <span class="text-red-500">*</span></label>
          <select id="addRole" class="input w-full">
            <option value="">-- Pilih Role --</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">No. HP</label>
          <input type="tel" id="addPhone" class="input w-full" placeholder="08xxxxxxxxx">
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="addActive" checked class="w-4 h-4 rounded border-gray-300 text-blue-600">
          <label for="addActive" class="text-sm text-gray-700">Akun aktif</label>
        </div>
      </div>
      <div class="p-6 border-t border-gray-100 flex justify-end gap-2">
        <button onclick="closeAddModal()" class="btn bg-gray-100 text-gray-700 hover:bg-gray-200">Batal</button>
        <button onclick="saveAdmin()" class="btn btn-primary">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg max-w-md w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center">
        <h3 class="text-lg font-semibold">Edit Admin</h3>
        <button onclick="closeEditModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-gray-500">close</span>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <input type="hidden" id="editId" value="">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
          <input type="text" id="editName" class="input w-full">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="editEmail" class="input w-full">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
          <select id="editRole" class="input w-full">
            <option value="">-- Pilih Role --</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">No. HP</label>
          <input type="tel" id="editPhone" class="input w-full">
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="editActive" class="w-4 h-4 rounded border-gray-300 text-blue-600">
          <label for="editActive" class="text-sm text-gray-700">Akun aktif</label>
        </div>
        <div class="border-t border-gray-100 pt-4 mt-2">
          <label class="flex items-center gap-2 cursor-pointer mb-3">
            <input type="checkbox" id="editResetPw" class="w-4 h-4 rounded border-gray-300 text-blue-600">
            <span class="text-sm text-gray-700">Reset password</span>
          </label>
          <div id="editNewPwWrap" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Password Baru</label>
            <input type="password" id="editNewPw" class="input w-full" placeholder="Password baru">
          </div>
        </div>
      </div>
      <div class="p-6 border-t border-gray-100 flex justify-end gap-2">
        <button onclick="closeEditModal()" class="btn bg-gray-100 text-gray-700 hover:bg-gray-200">Batal</button>
        <button onclick="updateAdmin()" class="btn btn-primary">Update</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
    <span id="toastIcon" class="material-symbols-outlined">check_circle</span>
    <span id="toastMsg"></span>
  </div>
</AdminLayout>

<script is:inline>
let allData = [];
let filteredData = [];
let currentPage = 1;
let viewerRole = 'guru';
let viewerId = null;
const itemsPerPage = 20;

const roleLabels = {
  super_admin: { text: 'Super Admin', class: 'bg-purple-50 text-purple-600' },
  admin_tu: { text: 'Admin TU', class: 'bg-blue-50 text-blue-600' },
  guru: { text: 'Guru', class: 'bg-emerald-50 text-emerald-600' }
};

function formatDate(dateStr) {
  if (!dateStr) return '-';
  try {
    return new Date(dateStr).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch { return dateStr; }
}

async function loadUsers(page = 1) {
  currentPage = page;
  const tbody = document.getElementById('usersBody');
  tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Memuat data...</td></tr>';

  try {
    const res = await fetch('/api/admin/admin-users?limit=1000', { credentials: 'include' });
    const result = await res.json();

    if (result.success) {
      allData = result.data || [];
      viewerRole = result.viewerRole || 'guru';
      viewerId = result.viewerId || null;
      
      // Populate dynamic roles
      if (result.roles && result.roles.length > 0) {
        populateRoleDropdowns(result.roles);
      }

      // Show/hide add button based on role
      if (viewerRole === 'super_admin' || viewerRole === 'kepsek') {
        document.getElementById('btnAddAdmin').classList.remove('hidden');
      }

      applyFilters();
      updateStats();
    } else {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Gagal memuat data</td></tr>';
    }
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Terjadi kesalahan</td></tr>';
  }
}

function updateStats() {
  document.getElementById('statTotal').textContent = allData.length;
  document.getElementById('statSuper').textContent = allData.filter(u => u.role === 'super_admin').length;
  document.getElementById('statActive').textContent = allData.filter(u => u.is_active).length;
}

function populateRoleDropdowns(roles) {
  // Update roleLabels map for table rendering
  roles.forEach(r => {
    if (!roleLabels[r.name]) {
      roleLabels[r.name] = { text: r.label, class: 'bg-indigo-50 text-indigo-600' };
    }
  });

  // Render Add Role
  const addRoleSel = document.getElementById('addRole');
  const addRoleVal = addRoleSel.value;
  addRoleSel.innerHTML = '<option value="">-- Pilih Role --</option>' + roles.map(r => `<option value="${r.name}">${r.label}</option>`).join('');
  if (addRoleVal) addRoleSel.value = addRoleVal;

  // Render Edit Role
  const editRoleSel = document.getElementById('editRole');
  const editRoleVal = editRoleSel.value;
  editRoleSel.innerHTML = '<option value="">-- Pilih Role --</option>' + roles.map(r => `<option value="${r.name}">${r.label}</option>`).join('');
  if (editRoleVal) editRoleSel.value = editRoleVal;

  // Render Filter Role
  const filterRoleSel = document.getElementById('roleFilter');
  const filterRoleVal = filterRoleSel.value;
  filterRoleSel.innerHTML = '<option value="">Semua Role</option>' + roles.map(r => `<option value="${r.name}">${r.label}</option>`).join('');
  if (filterRoleVal) filterRoleSel.value = filterRoleVal;
}

function applyFilters() {
  const search = document.getElementById('searchInput').value.toLowerCase().trim();
  const role = document.getElementById('roleFilter').value;

  filteredData = allData.filter(u => {
    const matchSearch = !search ||
      (u.full_name || '').toLowerCase().includes(search) ||
      (u.email || '').toLowerCase().includes(search) ||
      (u.auth_email || '').toLowerCase().includes(search);
    const matchRole = !role || u.role === role;
    return matchSearch && matchRole;
  });

  currentPage = 1;
  renderTable();
}

function renderTable() {
  const tbody = document.getElementById('usersBody');
  const total = filteredData.length;
  const start = (currentPage - 1) * itemsPerPage;
  const end = Math.min(start + itemsPerPage, total);
  const pageData = filteredData.slice(start, end);

  document.getElementById('pageInfo').textContent = `Menampilkan ${start + 1}-${end} dari ${total}`;

  const totalPages = Math.ceil(total / itemsPerPage) || 1;
  let pgHtml = '';
  if (currentPage > 1) pgHtml += `<button onclick="goPage(${currentPage - 1})" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm hover:bg-gray-50">Prev</button>`;
  pgHtml += `<span class="px-3 py-1.5 text-sm text-gray-600">${currentPage} / ${totalPages}</span>`;
  if (currentPage < totalPages) pgHtml += `<button onclick="goPage(${currentPage + 1})" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm hover:bg-gray-50">Next</button>`;
  document.getElementById('pageControls').innerHTML = pgHtml;

  if (!pageData.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-12 text-gray-400">Tidak ada data</td></tr>';
    return;
  }

  tbody.innerHTML = pageData.map(u => {
    const rl = roleLabels[u.role] || { text: u.role, class: 'bg-gray-50 text-gray-600' };
    const lastLogin = u.last_sign_in_at ? formatDate(u.last_sign_in_at) : 'Belum pernah';

    // Activity
    let activityHtml = '<span class="text-xs text-gray-400">-</span>';
    if (u.last_activity) {
      const actLabels = {
        'CREATE_ADMIN_USER': 'Menambah admin',
        'UPDATE_ADMIN_USER': 'Mengupdate admin',
        'DELETE_ADMIN_USER': 'Menghapus admin',
        'VERIFY_REGISTRATION_APPROVED': 'Verifikasi pendaftar',
        'VERIFY_REGISTRATION_REJECTED': 'Tolak pendaftar',
        'UPDATE_REGISTRATION': 'Update pendaftar',
        'SCHEDULE_TEST': 'Jadwal tes',
        'ANNOUNCE_RESULT': 'Umumkan hasil'
      };
      const actText = actLabels[u.last_activity.action] || u.last_activity.action;
      activityHtml = `<div class="text-xs"><span class="text-gray-600">${actText}</span><div class="text-gray-400">${formatDate(u.last_activity.created_at)}</div></div>`;
    }

    // Actions - superadmin and kepsek can edit/delete, but cannot delete self
    const canEdit = viewerRole === 'super_admin' || viewerRole === 'kepsek';
    const canDelete = (viewerRole === 'super_admin' || viewerRole === 'kepsek') && u.id !== viewerId;
    const actions = [];
    if (canEdit) {
      actions.push(`<button onclick="openEditModal('${u.id}')" class="w-8 h-8 rounded-lg hover:bg-blue-50 text-blue-600 flex items-center justify-center" title="Edit"><span class="material-symbols-outlined" style="font-size:18px;">edit</span></button>`);
    }
    if (canDelete) {
      actions.push(`<button onclick="deleteAdmin('${u.id}')" class="w-8 h-8 rounded-lg hover:bg-red-50 text-red-500 flex items-center justify-center" title="Hapus"><span class="material-symbols-outlined" style="font-size:18px;">delete</span></button>`);
    }

    return `<tr class="hover:bg-gray-50 transition-colors">
      <td>
        <div class="font-medium text-sm text-gray-900">${u.full_name || '-'}</div>
        <div class="text-xs text-gray-400">${formatDate(u.created_at)}</div>
      </td>
      <td class="text-sm text-gray-600">${u.auth_email || u.email || '-'}</td>
      <td><span class="badge ${rl.class} text-xs">${rl.text}</span></td>
      <td><span class="badge ${u.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-gray-50 text-gray-500'} text-xs">${u.is_active ? 'Aktif' : 'Nonaktif'}</span></td>
      <td class="text-xs text-gray-500">${lastLogin}</td>
      <td>${activityHtml}</td>
      <td>
        <div class="flex gap-1">
          ${actions.join('')}
        </div>
      </td>
    </tr>`;
  }).join('');
}

function goPage(p) { currentPage = p; renderTable(); }

// Add Modal
document.getElementById('btnAddAdmin').addEventListener('click', () => {
  document.getElementById('addModal').classList.remove('hidden');
});

function closeAddModal() {
  document.getElementById('addModal').classList.add('hidden');
  document.getElementById('addName').value = '';
  document.getElementById('addEmail').value = '';
  document.getElementById('addPassword').value = '';
  document.getElementById('addRole').value = 'admin_tu';
  document.getElementById('addPhone').value = '';
  document.getElementById('addActive').checked = true;
}

async function saveAdmin() {
  const full_name = document.getElementById('addName').value.trim();
  const email = document.getElementById('addEmail').value.trim();
  const password = document.getElementById('addPassword').value;
  const role = document.getElementById('addRole').value;
  const phone = document.getElementById('addPhone').value.trim();
  const is_active = document.getElementById('addActive').checked;

  if (!full_name || !email || !password || !role) {
    showToast('Nama, email, password, dan role wajib diisi', 'error');
    return;
  }
  if (password.length < 6) {
    showToast('Password minimal 6 karakter', 'error');
    return;
  }

  try {
    const res = await fetch('/api/admin/admin-users', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ full_name, email, password, role, phone, is_active })
    });
    const result = await res.json();
    if (result.success) {
      showToast('Admin berhasil ditambahkan');
      closeAddModal();
      loadUsers();
    } else {
      showToast(result.error || 'Gagal menambahkan admin', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Edit Modal
function openEditModal(id) {
  const u = allData.find(x => x.id === id);
  if (!u) return;
  document.getElementById('editId').value = u.id;
  document.getElementById('editName').value = u.full_name || '';
  document.getElementById('editEmail').value = u.auth_email || u.email || '';
  document.getElementById('editRole').value = u.role;
  document.getElementById('editPhone').value = u.phone || '';
  document.getElementById('editActive').checked = u.is_active;
  document.getElementById('editResetPw').checked = false;
  document.getElementById('editNewPw').value = '';
  document.getElementById('editNewPwWrap').classList.add('hidden');
  document.getElementById('editModal').classList.remove('hidden');
}

function closeEditModal() {
  document.getElementById('editModal').classList.add('hidden');
}

document.getElementById('editResetPw').addEventListener('change', function() {
  document.getElementById('editNewPwWrap').classList.toggle('hidden', !this.checked);
});

async function updateAdmin() {
  const id = document.getElementById('editId').value;
  const full_name = document.getElementById('editName').value.trim();
  const email = document.getElementById('editEmail').value.trim();
  const role = document.getElementById('editRole').value;
  const phone = document.getElementById('editPhone').value.trim();
  const is_active = document.getElementById('editActive').checked;
  const reset_password = document.getElementById('editResetPw').checked;
  const new_password = document.getElementById('editNewPw').value;

  if (reset_password && (!new_password || new_password.length < 6)) {
    showToast('Password baru minimal 6 karakter', 'error');
    return;
  }

  try {
    const body = { id, full_name, email, role, phone, is_active };
    if (reset_password) { body.reset_password = true; body.new_password = new_password; }

    const res = await fetch('/api/admin/admin-users', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(body)
    });
    const result = await res.json();
    if (result.success) {
      showToast('Admin berhasil diupdate');
      closeEditModal();
      loadUsers();
    } else {
      showToast(result.error || 'Gagal mengupdate admin', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Delete
async function deleteAdmin(id) {
  if (!confirm('Hapus admin ini? Tindakan tidak bisa dibatalkan.')) return;
  try {
    const res = await fetch(`/api/admin/admin-users?id=${id}`, {
      method: 'DELETE',
      credentials: 'include'
    });
    const result = await res.json();
    if (result.success) {
      showToast('Admin dihapus');
      loadUsers();
    } else {
      showToast(result.error || 'Gagal menghapus', 'error');
    }
  } catch (e) {
    showToast('Terjadi kesalahan', 'error');
  }
}

// Filter
document.getElementById('btnFilter').addEventListener('click', applyFilters);
document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('roleFilter').addEventListener('change', applyFilters);

function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toastIcon').textContent = type === 'error' ? 'error' : 'check_circle';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

loadUsers();
</script>
